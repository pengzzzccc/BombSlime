<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Settings.uss" />
    <!-- Settings, one page on the page frame: the title top left, then a single scrolling list
         on a plate in the centred content column — AUDIO, VIDEO and CONTROLS one after another,
         each a section title followed by its rows (label left, value / bar / key icons right).
         SettingsPanel's sections build the rows into #Rows; prompts bottom right. -->
    <ui:VisualElement name="Settings" class="screen dim frame">
        <ui:VisualElement class="frame-header" picking-mode="Ignore">
            <ui:Label name="Title" text="OPTIONS" class="page-title title-font header-outline" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement class="frame-content" picking-mode="Ignore">
            <ui:VisualElement class="content-column settings-column plate">
                <ui:ScrollView name="Scroll" class="settings-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:VisualElement name="Rows" class="settings-rows" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="frame-footer" picking-mode="Ignore">
            <ui:VisualElement name="PromptBar" class="prompt-bar" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
