  m_Name: TutorialHints
  m_EditorClassIdentifier: Assembly-CSharp::Inkform.UI.TutorialHintSet
  hints:
  - hint: 0
    keyboardText: '{Move} to move'
    gamepadText: '{Move} to move'
  - hint: 1
    keyboardText: Press {Jump} to jump, hold to jump higher
    gamepadText: Press {Jump} to jump, hold to jump higher
  - hint: 2
    keyboardText: Aim with the mouse, click {RopeFire} to hook, click again to let
      go
    gamepadText: Aim with {Aim}, press {RopeFire} to hook, press again to let go
  - hint: 3
    keyboardText: Hook on Bomb, Press {SpitBomb} to throw a bomb at the reticle
    gamepadText: Hook on Bomb, Press {SpitBomb} to throw a bomb at the reticle
  - hint: 4
    keyboardText: Grap a Bomb, Press {Dash} to dash toward the reticle
    gamepadText: Grap a Bomb, Press {Dash} to dash toward the reticle
  - hint: 5
    keyboardText: Jump {Jump} to briefly move along the ceiling
    gamepadText: Jump {Jump} to briefly move along the ceiling
