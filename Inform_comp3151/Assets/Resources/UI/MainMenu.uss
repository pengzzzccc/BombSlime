/* Main menu — the game logo is the title, centred in the upper part of the screen; the menu is
   one row of buttons across the lower part, no backing plate. */

/* Game logo, placed by its centre as a share of the screen. This is its resting spot above the
   menu; on the title screen MainMenuPanel overrides left / top / size inline (centred, larger)
   and tweens back to these values. 768 px = 12x the 64 px pixel art (MainMenuPanel.MenuLogoSize). */
.main-logo {
    position: absolute;
    left: 50%;
    top: 38%;
    width: 768px;
    height: 768px;
    translate: -50% -50%;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    align-items: center;
    justify-content: center;
}

.main-logo-placeholder {
    display: none;
    font-size: var(--fs-title);
    color: var(--c-white);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Title screen prompt under the centred logo (below the x13 logo); MainMenuPanel shows it and drives its breathing */
.press-any-key {
    display: none;
    position: absolute;
    left: 50%;
    top: 87%;
    translate: -50% -50%;
    font-size: var(--fs-item);
    color: var(--c-white);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* The menu row: four buttons spread evenly across the safe width, its top edge 80% down the screen */
.main-menu-row {
    position: absolute;
    left: var(--safe-x); right: var(--safe-x);
    top: 80%;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

/* Every button the same size, centred on its own spot, growing from its centre when selected */
.main-menu-item {
    font-size: var(--fs-section);
    -unity-text-align: middle-center;
    transform-origin: center;
    margin: 0;
    padding: 6px 18px;
}
