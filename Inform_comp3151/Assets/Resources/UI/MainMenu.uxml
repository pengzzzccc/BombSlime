<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="MainMenu.uss" />
    <!-- Main menu over the cave backdrop (MenuBackdrop.uxml, a layer of its own). Three layers:
         - LogoLayer: the game logo — the menu's title — and "Press any key", placed by percentage
           of the whole screen. On the title screen the logo sits centred with the prompt under it;
           MainMenuPanel then moves it up to its spot above the menu (.main-logo) as the menu
           slides in.
         - MenuColumn: the menu, one row of buttons across the lower part of the screen
           (BEGIN, OPTIONS, EXIT, CREDITS), no backing plate.
         - Frame: the shared page frame — version bottom left, device-aware prompts bottom right.
         MenuColumn / Footer are hidden on the title screen and slide in after it. The version
         text and the logo art are filled in by MainMenuPanel; the prompts by its DefinePrompts. -->
    <ui:VisualElement name="MainMenu" class="screen">
        <ui:VisualElement name="LogoLayer" class="screen" picking-mode="Ignore">
            <ui:VisualElement name="Logo" class="main-logo" picking-mode="Ignore">
                <ui:Label name="LogoPlaceholder" text="BOMB SLIME" class="main-logo-placeholder title-font header-outline" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="PressAnyKey" text="Press any key" class="press-any-key outline" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="MenuColumn" class="main-menu-row" picking-mode="Ignore">
            <ui:Button name="Btn_Begin" text="BEGIN" class="menu-item main-menu-item floaty outline" />
            <ui:Button name="Btn_Settings" text="OPTIONS" class="menu-item main-menu-item floaty outline" />
            <ui:Button name="Btn_Exit" text="EXIT" class="menu-item main-menu-item floaty outline" />
            <ui:Button name="Btn_Credits" text="CREDITS" class="menu-item main-menu-item floaty outline" />
        </ui:VisualElement>
        <ui:VisualElement name="Frame" class="screen frame" picking-mode="Ignore">
            <ui:VisualElement class="frame-content" picking-mode="Ignore" />
            <ui:VisualElement name="Footer" class="frame-footer" picking-mode="Ignore">
                <ui:Label name="Lbl_Version" class="version-label outline" picking-mode="Ignore" />
                <ui:VisualElement name="PromptBar" class="prompt-bar" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
